{
 "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
 "version": "2.1.0",
 "runs": [
  {
   "tool": {
    "driver": {
     "name": "Trivy",
     "rules": [
      {
       "id": "CVE-2023-32681",
       "name": "LanguageSpecificPackageVulnerability",
       "shortDescription": {
        "text": "requests: Unintended leak of Proxy-Authorization header"
       },
       "help": {
        "text": "Package: requests\nInstalled Version: 2.19.0\nFixed Version: 2.31.0"
       },
       "defaultConfiguration": {
        "level": "error"
       },
       "properties": {
        "tags": [
         "vulnerability",
         "security",
         "HIGH"
        ],
        "security-severity": "7.5"
       }
      },
      {
       "id": "CVE-2022-0000",
       "name": "LanguageSpecificPackageVulnerability",
       "shortDescription": {
        "text": "example: no location result"
       },
       "defaultConfiguration": {
        "level": "warning"
       },
       "properties": {
        "tags": [
         "vulnerability",
         "MEDIUM"
        ]
       }
      }
     ]
    }
   },
   "results": [
    {
     "ruleId": "CVE-2023-32681",
     "ruleIndex": 0,
     "level": "error",
     "message": {
      "text": "Package: requests\nInstalled Version: 2.19.0\nVulnerability CVE-2023-32681\nSeverity: HIGH\nFixed Version: 2.31.0"
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "requirements.txt",
         "uriBaseId": "%SRCROOT%"
        },
        "region": {
         "startLine": 1,
         "endLine": 1
        }
       }
      }
     ]
    },
    {
     "ruleId": "CVE-2022-0000",
     "ruleIndex": 1,
     "level": "warning",
     "message": {
      "text": "Package: example 1.0"
     }
    }
   ]
  }
 ]
}